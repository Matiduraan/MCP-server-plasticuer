{
  "name": "plasticuer-api",
  "version": "0.1.0",
  "description": "API REST de productos (precio y stock) sobre la base SQL Server de Plasticuer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plasticuer-api": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test test/api.test.ts",
    "probar": "tsx scripts/probar-productos.ts",
    "introspect": "tsx scripts/introspect-schema.ts",
    "explore": "tsx scripts/explore-stock-precios.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
