{
  "name": "plasticuer-server-mcp",
  "version": "0.1.0",
  "description": "Servidor MCP que expone operaciones sobre la base SQL Server de Plasticuer",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "plasticuer-server-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "introspect": "tsx scripts/introspect-schema.ts",
    "explore": "tsx scripts/explore-stock-precios.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "dotenv": "^16.4.5",
    "mssql": "^11.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.5",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
