# Conexión a SQL Server (equivalente a jdbc:sqlserver://;serverName=...;databaseName=...)
DB_SERVER=25.133.131.194
DB_PORT=1433
DB_NAME=plasticuer
DB_USER=
DB_PASSWORD=

# Servidor on-premise con certificado autofirmado: dejar encrypt=true y confiar en el certificado
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# El servidor de Plasticuer solo soporta TLS 1.0: sin esto Node falla con
# "ssl_choose_client_version:unsupported protocol". Dejar vacío para servidores modernos.
DB_TLS_MIN_VERSION=TLSv1

# Opcional: instancia con nombre (ej. SQLEXPRESS). Si se usa, el puerto se ignora.
DB_INSTANCE=

# Timeouts (ms)
DB_CONNECTION_TIMEOUT=15000
DB_REQUEST_TIMEOUT=30000
